# Host-local overrides for running TwinStudio directly from a Python virtual
# environment. These values take precedence over the Docker-oriented .env file.
TWINSTUDIO_HOST=127.0.0.1
TWINSTUDIO_PORT=8000
TWINSTUDIO_PUBLIC_URL=http://localhost:8000
TWINSTUDIO_PROJECT_ROOT=.
TWINSTUDIO_DATA_DIR=./data
# Optional command prefix for a sandboxed OpenSCAD runtime. TwinStudio sends
# source via stdin, and receives CSG via stdout. The default is `openscad`.
# TWINSTUDIO_OPENSCAD_COMMAND=docker compose -f /absolute/path/to/viewer/docker-compose.yml exec -T viewer openscad
DATABASE_URL=sqlite:///./data/twinstudio.db

SMTP_HOST=
MQTT_ENABLED=false
MQTT_HOST=localhost

MCP_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000
