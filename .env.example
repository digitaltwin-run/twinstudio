LPS_HOST=0.0.0.0
LPS_PORT=8000
LPS_PUBLIC_URL=http://localhost:8000
LPS_DATA_DIR=/data
DATABASE_URL=sqlite:////data/lps.db

DEV_AUTH_BYPASS=true
DEV_USER_EMAIL=creator@example.test
JWT_SECRET=replace-with-at-least-32-random-characters
INVITATION_TTL_HOURS=48
SESSION_TTL_HOURS=24

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=lps@example.test
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=false

MQTT_ENABLED=true
MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=lps/v1

LITELLM_MODEL=
LITELLM_API_BASE=
LITELLM_API_KEY=

# MCP 2026-07-28 Streamable HTTP Origin allow-list. Requests without an
# Origin header (typical server-to-server clients) are still authenticated.
MCP_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

ARTIFACT_BACKEND=local
S3_ENDPOINT=http://minio:9000
S3_BUCKET=lps-artifacts
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

OPENWEBUI_IMAGE=ghcr.io/open-webui/open-webui:main
WEBUI_SECRET_KEY=replace-with-another-long-random-secret

# Optional MQTT-to-REST service account. Create a personal/service API token after
# disabling the development authentication bypass.
LPS_SERVICE_EMAIL=mqtt-gateway@example.test
LPS_SERVICE_TOKEN=
LPS_API_BASE=http://app:8000
