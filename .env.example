TWINSTUDIO_HOST=0.0.0.0
TWINSTUDIO_PORT=8000
TWINSTUDIO_PUBLIC_URL=http://localhost:8000
TWINSTUDIO_PROJECT_ROOT=.
TWINSTUDIO_DATA_DIR=/data
TWINSTUDIO_HOST_PORT=8000
TWINSTUDIO_APP_IMAGE=twinstudio-app
TWINSTUDIO_APP_TAG=latest
TWINSTUDIO_EXPORT_EXTENSION=.twinstudio.zip
TWINSTUDIO_DATA_VOLUME=twinstudio_twinstudio-data
TWINSTUDIO_DATA_VOLUME_EXTERNAL=false
DATABASE_URL=sqlite:////data/twinstudio.db
# Docker Compose uses PostgreSQL by default. Override this only when reusing an
# existing database or an externally managed PostgreSQL instance.
TWINSTUDIO_COMPOSE_DATABASE_URL=postgresql+psycopg://twinstudio:twinstudio@postgres:5432/twinstudio
TWINSTUDIO_POSTGRES_DB=twinstudio
TWINSTUDIO_POSTGRES_USER=twinstudio
TWINSTUDIO_POSTGRES_PASSWORD=twinstudio

DEV_AUTH_BYPASS=true
DEV_USER_EMAIL=creator@example.test
JWT_SECRET=replace-with-at-least-32-random-characters
INVITATION_TTL_HOURS=48
SESSION_TTL_HOURS=24

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=twinstudio@example.test
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=false
MAILPIT_HOST_PORT=8025

MQTT_ENABLED=true
MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=twinstudio/v1
MQTT_HOST_PORT=1883

# Automatically rebuild visible STL/SVG revisions after apply and undo.
TWINSTUDIO_CAD_REGEN_ENABLED=true

LITELLM_MODEL=
LITELLM_API_BASE=
LITELLM_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# MCP 2026-07-28 Streamable HTTP Origin allow-list.
MCP_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000

ARTIFACT_BACKEND=local
S3_ENDPOINT=http://minio:9000
S3_BUCKET=twinstudio-artifacts
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

OPENWEBUI_IMAGE=ghcr.io/open-webui/open-webui:main
WEBUI_SECRET_KEY=replace-with-another-long-random-secret
OPENWEBUI_HOST_PORT=3000

# Optional MQTT-to-REST service account.
TWINSTUDIO_SERVICE_EMAIL=mqtt-gateway@example.test
TWINSTUDIO_SERVICE_TOKEN=
TWINSTUDIO_API_BASE=http://app:8000

# Legacy LPS_* variables remain accepted by the Python application during the 0.5 migration cycle.
