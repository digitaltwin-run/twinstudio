# LiteLLM is optional. Without LITELLM_MODEL the application uses a conservative local parser.
# Use any provider/model supported by your LiteLLM installation.
LITELLM_MODEL=
# Example: LITELLM_MODEL=openai/your-model-name

# Provider-specific keys are normally read directly by LiteLLM, for example:
# OPENAI_API_KEY=...
# ANTHROPIC_API_KEY=...
# GEMINI_API_KEY=...

# Optional OpenAI-compatible endpoint or LiteLLM proxy.
# LITELLM_API_BASE=http://localhost:4000
# LITELLM_API_KEY=...
LITELLM_TIMEOUT=60

# Generated artifacts directory.
HOUSING_GENERATED_DIR=./generated
