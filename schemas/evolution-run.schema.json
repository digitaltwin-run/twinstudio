          "title": "Constraint Violations",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/CandidateStatus",
          "default": "proposed"
        },
        "source": {
          "default": "local",
          "enum": [
            "local",
            "litellm",
            "human",
            "dsl"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "title",
        "summary"
      ],
      "title": "EvolutionCandidate",
      "type": "object"
    },
    "EvolutionGateSpec": {
      "additionalProperties": false,
      "properties": {
        "phase": {
          "$ref": "#/$defs/EvolutionPhase"
        },
        "expressions": {
          "items": {
            "type": "string"
          },
          "title": "Expressions",
          "type": "array"
        },
        "approver_roles": {
          "items": {
            "$ref": "#/$defs/Role"
