        },
        "outcomes": {
          "items": {
            "type": "string"
          },
          "title": "Outcomes",
          "type": "array"
        },
        "preserve": {
          "items": {
            "type": "string"
          },
          "title": "Preserve",
          "type": "array"
        },
        "avoid": {
          "items": {
            "type": "string"
          },
          "title": "Avoid",
          "type": "array"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "constraints": {
          "items": {
            "type": "string"
          },
          "title": "Constraints",
          "type": "array"
        }
      },
      "required": [
        "statement"
      ],
      "title": "EvolutionGoal",
      "type": "object"
