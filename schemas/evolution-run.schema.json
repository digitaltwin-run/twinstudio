        "goal_ladder",
        "object_decomposition",
        "bidirectional_graph",
        "feature_lenses",
        "adjacent_possible",
        "brainswarm",
        "analogy",
        "assumption_reversal",
        "constraint_relaxation",
        "mutation",
        "recombination",
        "experiment"
      ],
      "title": "EvolutionMethod",
      "type": "string"
    },
    "EvolutionOperatorSpec": {
      "additionalProperties": false,
      "properties": {
        "operator": {
          "$ref": "#/$defs/MutationOperatorKind"
        },
        "weight": {
          "default": 1.0,
          "exclusiveMinimum": 0.0,
          "maximum": 100.0,
          "title": "Weight",
          "type": "number"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
