{
  "$defs": {
    "ActionRelation": {
      "enum": [
        "seed",
        "hypernym",
        "hyponym",
        "synonym",
        "sibling",
        "opposite",
        "related",
        "custom"
      ],
      "title": "ActionRelation",
      "type": "string"
    },
    "ActionSearchSpec": {
      "additionalProperties": false,
      "properties": {
        "seed_verbs": {
          "items": {
            "type": "string"
          },
          "title": "Seed Verbs",
          "type": "array"
        },
        "up_depth": {
          "default": 1,
          "maximum": 5,
          "minimum": 0,
          "title": "Up Depth",
          "type": "integer"
        },
        "down_depth": {
          "default": 2,
          "maximum": 5,
          "minimum": 0,
          "title": "Down Depth",
          "type": "integer"
        },
        "sideways_depth": {
          "default": 1,
          "maximum": 5,
          "minimum": 0,
          "title": "Sideways Depth",
          "type": "integer"
        },
        "include_opposites": {
          "default": true,
          "title": "Include Opposites",
          "type": "boolean"
        },
        "max_terms": {
          "default": 40,
          "maximum": 250,
          "minimum": 1,
          "title": "Max Terms",
          "type": "integer"
        }
      },
      "title": "ActionSearchSpec",
      "type": "object"
    },
    "CandidateEvaluation": {
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "$ref": "#/$defs/EvaluationDimension"
        },
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        },
        "rationale": {
          "default": "",
          "title": "Rationale",
          "type": "string"
        },
        "evidence_uris": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Uris",
          "type": "array"
        }
      },
      "required": [
        "dimension",
        "score"
      ],
      "title": "CandidateEvaluation",
      "type": "object"
    },
    "CandidateStatus": {
      "enum": [
        "proposed",
        "shortlisted",
        "selected",
        "rejected",
        "realized",
        "verified"
      ],
      "title": "CandidateStatus",
      "type": "string"
    },
    "ChangeOperation": {
      "additionalProperties": false,
      "properties": {
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ChangeOperationKind"
        },
        "target_uri": {
          "title": "Target Uri",
          "type": "string"
        },
        "selector": {
          "additionalProperties": true,
          "title": "Selector",
          "type": "object"
        },
        "arguments": {
          "additionalProperties": true,
          "title": "Arguments",
          "type": "object"
        },
        "rationale": {
          "default": "",
          "title": "Rationale",
          "type": "string"
        },
        "confidence": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "reversible": {
          "default": true,
          "title": "Reversible",
          "type": "boolean"
        },
        "validation_steps": {
          "items": {
            "type": "string"
          },
          "title": "Validation Steps",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "target_uri"
      ],
      "title": "ChangeOperation",
      "type": "object"
    },
    "ChangeOperationKind": {
      "enum": [
        "set_parameter",
        "add_feature",
        "suppress_feature",
        "transform_feature",
        "boolean_cut",
        "boolean_add",
        "replace_component",
        "update_manufacturing",
        "attach_requirement",
        "add_test",
        "add_annotation"
      ],
      "title": "ChangeOperationKind",
      "type": "string"
    },
    "DslMetadata": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 200,
          "minLength": 3,
          "title": "Name",
          "type": "string"
        },
        "namespace": {
          "default": "default",
          "title": "Namespace",
          "type": "string"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Labels",
          "type": "object"
        },
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Annotations",
          "type": "object"
        }
      },
      "required": [
        "name"
      ],
      "title": "DslMetadata",
      "type": "object"
    },
    "EvaluationDimension": {
      "enum": [
        "feasibility",
        "novelty",
        "manufacturability",
        "evidence",
        "risk_control",
        "reversibility",
        "sustainability",
        "cost_value",
        "user_value",
        "lifecycle_fit"
      ],
      "title": "EvaluationDimension",
      "type": "string"
    },
    "EvaluationPolicy": {
      "additionalProperties": false,
      "properties": {
        "weights": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Weights",
          "type": "object"
        },
        "hard_constraints": {
          "items": {
            "type": "string"
          },
          "title": "Hard Constraints",
          "type": "array"
        },
        "select_top": {
          "default": 5,
          "maximum": 50,
          "minimum": 1,
          "title": "Select Top",
          "type": "integer"
        },
        "minimum_overall_score": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Minimum Overall Score",
          "type": "number"
        }
      },
      "title": "EvaluationPolicy",
      "type": "object"
    },
    "EvolutionCandidate": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "generation": {
          "default": 0,
          "minimum": 0,
          "title": "Generation",
          "type": "integer"
        },
        "parent_ids": {
          "items": {
            "type": "string"
          },
          "title": "Parent Ids",
          "type": "array"
        },
        "methods": {
          "items": {
            "$ref": "#/$defs/EvolutionMethod"
          },
          "title": "Methods",
          "type": "array"
        },
        "goal_node_ids": {
          "items": {
            "type": "string"
          },
          "title": "Goal Node Ids",
          "type": "array"
        },
        "resource_node_ids": {
          "items": {
            "type": "string"
          },
          "title": "Resource Node Ids",
          "type": "array"
        },
        "bridge_edge_ids": {
          "items": {
            "type": "string"
          },
          "title": "Bridge Edge Ids",
          "type": "array"
        },
        "lens_ids": {
          "items": {
            "type": "string"
          },
          "title": "Lens Ids",
          "type": "array"
        },
        "operators": {
          "items": {
            "$ref": "#/$defs/EvolutionOperatorSpec"
          },
          "title": "Operators",
          "type": "array"
        },
        "assumptions_challenged": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions Challenged",
          "type": "array"
        },
        "proposed_changes": {
          "items": {
            "$ref": "#/$defs/ChangeOperation"
          },
          "title": "Proposed Changes",
          "type": "array"
        },
        "expected_benefits": {
          "items": {
            "type": "string"
          },
          "title": "Expected Benefits",
          "type": "array"
        },
        "risks": {
          "items": {
            "type": "string"
          },
          "title": "Risks",
          "type": "array"
        },
        "validation_steps": {
          "items": {
            "type": "string"
          },
          "title": "Validation Steps",
          "type": "array"
        },
        "evaluations": {
          "items": {
            "$ref": "#/$defs/CandidateEvaluation"
          },
          "title": "Evaluations",
          "type": "array"
        },
        "overall_score": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Overall Score",
          "type": "number"
        },
        "constraint_violations": {
          "items": {
            "type": "string"
