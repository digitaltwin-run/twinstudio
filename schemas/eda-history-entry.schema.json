{
  "additionalProperties": false,
  "properties": {
    "schema_id": {
      "const": "twinstudio.eda-history-entry/v1",
      "default": "twinstudio.eda-history-entry/v1",
      "title": "Schema Id",
      "type": "string"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "stream_version": {
      "minimum": 1,
      "title": "Stream Version",
      "type": "integer"
    },
    "event_type": {
      "enum": [
        "EdaChangePlanned",
        "EdaSchematicAnalyzed",
        "EdaPcbAnalyzed",
        "EdaValidationCompleted",
        "EdaCandidateCreated",
        "EdaCandidateDeleted",
        "EdaChangeAccepted",
        "EdaChangeRejected",
        "EdaRevisionPromoted",
        "EdaChangeReverted",
        "EdaHistoryImported"
      ],
      "title": "Event Type",
      "type": "string"
    },
    "actor": {
      "title": "Actor",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "correlation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
